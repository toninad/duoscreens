// Cloudflare Worker config for studio.hearhere.media.
// Deploy: `npm run deploy` (Cloudflare Workers Builds runs it on every push to main).
// Secrets are set in the dashboard (Worker > Settings > Variables and Secrets), never here:
//   POLAR_ACCESS_TOKEN, ANTHROPIC_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Created automatically on the first deploy; tables come from migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "studio", "migrations_dir": "migrations" }
  ],
  // Pro sync: encrypted images, one object per image (<key hash>/<image id>). Create once:
  // `wrangler r2 bucket create studio-sync`.
  "r2_buckets": [
    { "binding": "SYNC", "bucket_name": "studio-sync" }
  ],
  // Daily cleanup of synced images no board uses (functions/api/sync.js, cleanupSync).
  "triggers": { "crons": ["23 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://studio.hearhere.media",
    "POLAR_ORGANIZATION_ID": "35b48af0-b858-4962-a867-599c50c2167b",
    "POLAR_BENEFIT_ID": "c1ac5b59-0307-4ba3-83ac-18199cc3ea06",
    "TRANSLATION_RUNS_PER_MONTH": "500",
    "SYNC_BYTES_PER_KEY": "1073741824",
    "SYNC_MAX_BOARDS": "200"
  },
  "observability": { "enabled": true }
}
